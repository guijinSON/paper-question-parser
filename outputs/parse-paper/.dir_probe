{"result":{"biographic_references":[],"contributors":{"authors":[{"aliases":[],"checked":"0","codes":["luo.yuetian"],"name":"Yuetian Luo"},{"aliases":[],"checked":"0","codes":["zhang.anru-r"],"name":"Anru R. Zhang"}],"author_references":[],"editors":[]},"database":"arXiv","datestamp":"0001-01-01T00:00:00Z","document_type":{"code":"p","description":"preprint"},"editorial_contributions":[{"language":null,"reviewer":{"author_code":null,"reviewer_id":null,"name":null,"sign":null},"text":"Summary: We note the significance of hypergraphic planted clique (HPC) detection in the investigation of computational hardness for a range of tensor problems. We ask if more evidence for the computational hardness of HPC detection can be developed. In particular, we conjecture if it is possible to establish the equivalence of the computational hardness between HPC and PC detection.","contribution_type":"summary"}],"id":900439329,"identifier":"arXiv:2009.05870","keywords":[null],"language":{"languages":[],"addition":[null]},"license":["http://creativecommons.org/licenses/by-sa/4.0/"],"links":[{"identifier":"2009.05870","type":"arxiv","url":"https://arxiv.org/abs/2009.05870"}],"msc":[],"references":[],"source":{"book":[],"pages":null,"series":[],"source":"Preprint, arXiv:2009.05870 [stat.ML] (2020)"},"states":[],"title":{"addition":null,"original":null,"subtitle":null,"title":"Open Problem: Average-Case Hardness of Hypergraphic Planted Clique Detection"},"year":"2020","zbmath_url":"https://zbmath.org/900439329"},"status":{"execution":"successful request","execution_bool":true,"internal_code":"ok","last_id":null,"nr_total_results":1,"nr_request_results":1,"query_execution_time_in_seconds":0.1025094985961914,"status_code":200,"time_stamp":"2026-05-12T19:43:07Z"}}